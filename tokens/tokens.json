{
  "$schema": "https://mewzak.design/schema/tokens-v1.json",
  "meta": {
    "name": "Mewzak",
    "version": "0.1.0",
    "phase": "design",
    "themeDefault": "dark",
    "description": "Platform-neutral semantic tokens for phase 2. Color values are CSS-ready sRGB hex; alpha tokens use rgba. Names are stable API: components consume semantic roles, never raw scales."
  },
  "color": {
    "dark": {
      "bg": "#0B0B0F",
      "bgDeep": "#08080B",
      "surface1": "#14141A",
      "surface2": "#1B1B23",
      "surface3": "#24242E",
      "surface4": "#2C2C38",
      "line": "rgba(245,245,247,0.08)",
      "lineStrong": "rgba(245,245,247,0.15)",
      "text": "#F5F5F7",
      "textSecondary": "#A1A1AA",
      "textTertiary": "#85858F",
      "accent": "#B79CFF",
      "accentSoft": "rgba(183,156,255,0.14)",
      "accentLine": "rgba(183,156,255,0.32)",
      "peach": "#FFB48A",
      "peachSoft": "rgba(255,180,138,0.13)",
      "onGradient": "#171021",
      "glassBg": "rgba(20,20,27,0.58)",
      "glassSolid": "#17171F",
      "glassBorder": "rgba(255,255,255,0.10)",
      "glassHighlight": "rgba(255,255,255,0.07)",
      "scrim": "rgba(6,6,10,0.70)"
    },
    "light": {
      "bg": "#F6F4FB",
      "bgDeep": "#EFEAF8",
      "surface1": "#FFFFFF",
      "surface2": "#F2EEFA",
      "surface3": "#E8E2F5",
      "surface4": "#DED6EF",
      "line": "rgba(26,20,48,0.09)",
      "lineStrong": "rgba(26,20,48,0.16)",
      "text": "#14121A",
      "textSecondary": "#5B5868",
      "textTertiary": "#7C7889",
      "accent": "#6B47E4",
      "accentSoft": "rgba(107,71,228,0.09)",
      "accentLine": "rgba(107,71,228,0.22)",
      "peach": "#EC9A72",
      "peachSoft": "rgba(236,154,114,0.14)",
      "onGradient": "#180F2C",
      "glassBg": "rgba(255,255,255,0.58)",
      "glassSolid": "#FFFFFF",
      "glassBorder": "rgba(26,20,48,0.08)",
      "glassHighlight": "rgba(255,255,255,0.75)",
      "scrim": "rgba(30,24,50,0.32)"
    },
    "artworkPalettes": {
      "lavender": ["#B79CFF", "#6E5BE0", "#FFB48A"],
      "peach": ["#FFB48A", "#E07E9E", "#B79CFF"],
      "blush": ["#F2A7C3", "#A46BD6", "#9EC5FF"],
      "night": ["#8FA8FF", "#3E4699", "#B79CFF"],
      "ice": ["#A8C6FF", "#5B7BE0", "#D9C7FF"],
      "plum": ["#C9A0FF", "#7A4BC8", "#FFB48A"],
      "cream": ["#F4D9C6", "#D9A3B8", "#B79CFF"],
      "sky": ["#C9E0FF", "#7F9BE8", "#E2C8FF"]
    }
  },
  "gradient": {
    "play": "linear-gradient(135deg,#B79CFF 0%,#CBB2FF 45%,#FFB48A 100%)",
    "heroWash": "linear-gradient(150deg,rgba(183,156,255,0.20),rgba(255,180,138,0.10))",
    "nowPlayingGlow": "radial-gradient(70% 60% at 50% 0%, var(--art-1), transparent 70%)"
  },
  "type": {
    "families": {
      "display": "Bricolage Grotesque",
      "ui": "Instrument Sans",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": [
      { "name": "displayXL", "size": 34, "lineHeight": 36, "tracking": -0.04, "weight": 600, "usage": "Onboarding, branded hero moments" },
      { "name": "displayL", "size": 28, "lineHeight": 31, "tracking": -0.035, "weight": 600, "usage": "Screen titles, playlist names (phone)" },
      { "name": "title1", "size": 22, "lineHeight": 26, "tracking": -0.025, "weight": 600, "usage": "Desktop page titles" },
      { "name": "title2", "size": 17, "lineHeight": 22, "tracking": -0.015, "weight": 600, "usage": "Section headers, cards" },
      { "name": "body", "size": 14, "lineHeight": 21, "tracking": -0.005, "weight": 400, "usage": "Default interface text" },
      { "name": "bodyStrong", "size": 13, "lineHeight": 19, "tracking": -0.005, "weight": 600, "usage": "Track titles, controls" },
      { "name": "caption", "size": 11.5, "lineHeight": 16, "tracking": 0, "weight": 500, "usage": "Metadata, durations, helper text" },
      { "name": "eyebrow", "size": 10.5, "lineHeight": 14, "tracking": 0.12, "weight": 650, "usage": "Section eyebrows, uppercase" }
    ]
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "base": 4
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 26,
    "2xl": 34,
    "pill": 999,
    "concentricRule": "innerRadius = outerRadius − inset"
  },
  "glass": {
    "blur": 26,
    "saturation": 1.6,
    "background": "var(--glass-bg)",
    "border": "1px solid var(--glass-brd)",
    "innerHighlight": "inset 0 1px 0 var(--glass-hi)",
    "fallback": "data-transparency=reduced swaps to solid --glass-solid and blur:0",
    "appliesTo": ["tabBar", "sidebar", "miniPlayer", "transport", "nowPlayingSheet", "contextMenu", "toast", "windowChrome"]
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 280, "scene": 460 },
    "easing": {
      "standard": "cubic-bezier(0.22,0.85,0.25,1)",
      "spring": "cubic-bezier(0.34,1.35,0.42,1)"
    },
    "rules": [
      "Motion confirms an action; it never delays one.",
      "Only transform and opacity animate on the functional layer.",
      "prefers-reduced-motion and the in-app switch both reduce to 1ms.",
      "Mascot animates at rest only; no looping motion in the transport."
    ]
  },
  "breakpoints": {
    "phone": 0,
    "phoneLarge": 430,
    "tablet": 768,
    "desktop": 1024,
    "desktopWide": 1440,
    "behavior": {
      "phone": "3-tab bar, docked mini player, full-screen Now Playing sheet",
      "tablet": "collapsible rail or 88px icon sidebar, 2–3 card columns, persistent mini player, optional right panel as overlay",
      "desktop": "transport bar, sidebar, resizable Now Playing panel, multi-column grids and track tables"
    }
  },
  "z": {
    "base": 0,
    "dock": 40,
    "sheet": 60,
    "menu": 70,
    "toast": 80,
    "chrome": 90
  },
  "accessibility": {
    "minimumTarget": 40,
    "contrast": {
      "darkTextOnBg": "18.04:1",
      "darkSecondaryOnBg": "7.66:1",
      "darkAccentOnBg": "8.62:1",
      "darkInkOnAccent": "8.13:1",
      "lightTextOnBg": "17.02:1",
      "lightSecondaryOnBg": "6.33:1",
      "lightAccentOnBg": "5.28:1"
    }
  }
}
