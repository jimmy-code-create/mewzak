{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Mewzak Phase 2 — Warm Editorial",
    "version": "0.2.0",
    "scope": "Onboarding, profile and the responsive shell. Phase 1 tokens remain in tokens/tokens.json.",
    "source": "src/styles/phase2.css"
  },
  "color": {
    "rust": "#7C2700",
    "rustHighlight": "#BE4A01",
    "deepMaroon": "#431518",
    "deepMaroonAlt": "#412519",
    "gradient": {
      "start": "#FD1F68",
      "mid": "#FF236C",
      "warm": "#FE4D2B",
      "end": "#FF9413",
      "value": "linear-gradient(90deg, #FD1F68 0%, #FF236C 28%, #FE4D2B 62%, #FF9413 100%)"
    },
    "cream": "#DFDEDA",
    "pageLight": "#EDEAE5",
    "cardLight": "#F4F1EB",
    "cardLightAlt": "#E4E0D9",
    "ink": "#171310",
    "inkMuted": "#6C655F",
    "darkButton": "#101010",
    "onDark": "#F7F4EF",
    "chipTransparent": "rgba(20, 16, 14, 0.56)",
    "chipSelected": "#DFDEDA",
    "disabled": "rgba(37, 28, 25, 0.34)",
    "lineLight": "rgba(23, 19, 16, 0.14)",
    "mesh": ["#CF6BC5", "#C971DF", "#F2532C", "#DD91BF", "#7C2700"],
    "darkSurface": "#1B1212",
    "darkCard": "#251817",
    "darkText": "#F4EDE7",
    "darkMuted": "#B9A9A1"
  },
  "typography": {
    "serif": "Fraunces",
    "sans": "DM Sans",
    "display": {
      "fontFamily": "Fraunces",
      "fontWeight": 500,
      "fontSize": "clamp(46px, 8cqw, 78px)",
      "lineHeight": 0.96,
      "letterSpacing": "-0.045em"
    },
    "title": {
      "fontFamily": "Fraunces",
      "fontWeight": 500,
      "fontSize": "clamp(32px, 5cqw, 48px)",
      "lineHeight": 1.02,
      "letterSpacing": "-0.035em"
    },
    "body": {
      "fontFamily": "DM Sans",
      "fontWeight": 400,
      "fontSize": 15,
      "lineHeight": 1.6
    },
    "label": {
      "fontFamily": "DM Sans",
      "fontWeight": 600,
      "fontSize": 11,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    }
  },
  "radius": {
    "input": "14px",
    "card": "20px",
    "cardLarge": "24px",
    "pill": "999px",
    "circle": "50%"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "motion": {
    "fast": "160ms",
    "base": "240ms",
    "slow": "400ms",
    "morph": "700ms",
    "ease": "cubic-bezier(0.22, 0.85, 0.25, 1)",
    "spring": "cubic-bezier(0.34, 1.35, 0.42, 1)",
    "stagger": "60ms"
  },
  "breakpoints": {
    "mobile": 0,
    "tablet": 640,
    "desktop": 1024,
    "wide": 1440
  },
  "layout": {
    "onboardingColumn": "440px",
    "contentMax": "1120px",
    "sidebar": "248px",
    "rail": "76px",
    "tabBarHeight": "68px",
    "miniPlayerHeight": "58px",
    "statusPillHeight": "38px"
  },
  "accessibility": {
    "minTarget": "44px",
    "bodyContrast": ">=4.5:1",
    "largeTextContrast": ">=3:1",
    "reducedMotion": "All transform loops stop; static gradients remain.",
    "reducedTransparency": "Glass is replaced by ink or cream solids with no blur."
  }
}
